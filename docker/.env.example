# Private Docker configuration. Generate docker/.env with setup.ps1.
# The root .env is not read by the containers or modified by this setup.
DOCKER_DB_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
DOCKER_DB_APP_PASSWORD=REPLACE_APP_PASSWORD
DOCKER_HTTP_PORT=8080
# Optional: path to a private Groq key file; never put the key itself here.
DOCKER_GROQ_KEY_FILE=
