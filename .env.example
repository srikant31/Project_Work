# Copy this file to .env and supply private local database credentials.
# Never commit .env or generated output/ credential files.
DB_USER=your_database_user
DB_PASSWORD=your_private_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rag_db

# Local HTTP development only. Set true when serving the console over HTTPS.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Groq (preferred for evaluation testing)
# LLM_PROVIDER=chat_completions
# LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=<your-groq-key>
# LLM_RESPONSE_FORMAT=json_object
# LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
# LLM_TIMEOUT_SECONDS=60

# Ollama (local, fallback)
# LLM_PROVIDER=ollama
# LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
# LLM_MODEL=qwen2.5:3b
# LLM_RESPONSE_FORMAT=json_schema
# LLM_TOKEN_LIMIT_FIELD=max_tokens
# LLM_TIMEOUT_SECONDS=180

# Uncomment one provider block above and supply credentials for Groq.
# To disable generation explicitly, use LLM_PROVIDER=disabled instead.
# This is a UTF-8 byte cap for the serialized messages, NOT an LLM token count.
RAG_MAX_CONTEXT_BYTES=12000
RAG_MAX_OUTPUT_TOKENS=512

# Optional private key file outside the project (used if LLM_API_KEY is empty).
LLM_API_KEY_FILE=

# Optional isolated local PDF OCR. off | auto (scanned-page fallback) | force
# Use force for complex layouts or images alongside text, followed by review.
DOCLING_PDF_MODE=off
# Empty uses .venv-docling/Scripts/python.exe in this Windows workspace.
DOCLING_PYTHON=
PDF_TEXT_EXTRACTOR=pymupdf4llm
# Selective OCR retains native text; full is an explicit recovery override.
DOCLING_OCR_MODE=selective

# Retrieval: vector (default), bm25, or hybrid (BM25 + vector RRF).
RETRIEVAL_MODE=hybrid
