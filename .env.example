# Copy this file to .env and supply private local database credentials.
# Never commit .env or generated output/ credential files.
DB_USER=your_database_user
DB_PASSWORD=your_private_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rag_db

# Local HTTP development only. Set true when serving the console over HTTPS.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Generation is deliberately disabled until a provider/model is chosen.
LLM_PROVIDER=disabled
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_schema
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
# This is a UTF-8 byte cap for the serialized messages, NOT an LLM token count.
RAG_MAX_CONTEXT_BYTES=12000
RAG_MAX_OUTPUT_TOKENS=512
