{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Helpdesk (port 8007)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8007"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}